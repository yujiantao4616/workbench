import type {
  AddProjectInput,
  AddProjectToTaskGroupInput,
  CancelTaskRunInput,
  CodexPromptStudioApi,
  CompleteTaskInput,
  CreateConversationInput,
  CreateProjectGroupInput,
  CreateTaskInput,
  CreateTasksFromConversationInput,
  CreateWorkItemInput,
  DeleteConversationInput,
  DeleteMemoryInput,
  DeleteTapdDefectsInput,
  DeleteWorkItemInput,
  DeleteTaskGroupInput,
  DeleteTaskInput,
  DeleteProjectGroupInput,
  ExpandPromptInput,
  GitCheckoutInput,
  GitCheckoutNewBranchInput,
  GitCommitInput,
  GitCommitSuggestionInput,
  GitPushInput,
  GitSnapshotInput,
  MoveProjectInput,
  MoveTaskGroupToReadyInput,
  OpenProjectInput,
  OpenExternalInput,
  RemoveProjectInput,
  SaveMemoryInput,
  SavePastedImageInput,
  ShowNotificationInput,
  StartTaskRunInput,
  SyncTapdBugStatusInput,
  TapdImportDefectsInput,
  TrackAnalyticsEventInput,
  TrashItemInput,
  UndoTaskRunInput,
  UpdateConversationInput,
  UpdateMemoryInput,
  UpdateProjectGroupInput,
  UpdateSettingsInput,
  UpdateTaskInput,
  UpdateWorkItemInput,
  WeeklyReportInput
} from '../shared/types.js';

const { contextBridge, ipcRenderer } = require('electron') as typeof import('electron');

const IPC_CHANNELS = {
  appState: 'app:state',
  selectProjectDirectory: 'project:select-directory',
  selectPromptFiles: 'prompt:select-files',
  savePastedImage: 'prompt:save-pasted-image',
  addProject: 'project:add',
  removeProject: 'project:remove',
  createProjectGroup: 'project-group:create',
  updateProjectGroup: 'project-group:update',
  deleteProjectGroup: 'project-group:delete',
  moveProject: 'project:move',
  rescanProject: 'project:rescan',
  createConversation: 'conversation:create',
  updateConversation: 'conversation:update',
  deleteConversation: 'conversation:delete',
  saveMemory: 'memory:save',
  updateMemory: 'memory:update',
  deleteMemory: 'memory:delete',
  expandPrompt: 'codex:expand-prompt',
  createTask: 'task:create',
  createTasksFromConversation: 'task:create-from-conversation',
  moveTaskGroupToReady: 'task-group:ready',
  addProjectToTaskGroup: 'task-group:add-project',
  updateTask: 'task:update',
  deleteTask: 'task:delete',
  deleteTaskGroup: 'task-group:delete',
  createWorkItem: 'work-item:create',
  updateWorkItem: 'work-item:update',
  deleteWorkItem: 'work-item:delete',
  updateSettings: 'settings:update',
  tapdSyncBugs: 'tapd:sync-bugs',
  tapdImportFile: 'tapd:import-file',
  tapdImportDefects: 'tapd:import-defects',
  deleteTapdDefects: 'tapd:delete-defects',
  syncTapdBugStatus: 'tapd:sync-bug-status',
  restoreTrashItem: 'trash:restore',
  permanentlyDeleteTrashItem: 'trash:delete-permanently',
  clearTrash: 'trash:clear-all',
  trackAnalyticsEvent: 'analytics:track',
  startTaskRun: 'task-run:start',
  cancelTaskRun: 'task-run:cancel',
  undoTaskRun: 'task-run:undo',
  completeTask: 'task:complete',
  weeklyReport: 'project:weekly-report',
  gitSnapshot: 'git:snapshot',
  gitCommit: 'git:commit',
  gitPush: 'git:push',
  gitBranchInfo: 'git:branch-info',
  gitCheckout: 'git:checkout',
  gitCheckoutNewBranch: 'git:checkout-new-branch',
  gitCommitSuggestion: 'git:commit-suggestion',
  openProjectInEditor: 'project:open-editor',
  openExternal: 'app:open-external',
  showNotification: 'app:show-notification',
  codexHealth: 'codex:health',
  runUpdate: 'task-run:update',
  runOpen: 'task-run:open'
} as const;

const api: CodexPromptStudioApi = {
  appState: () => ipcRenderer.invoke(IPC_CHANNELS.appState),
  selectProjectDirectory: () => ipcRenderer.invoke(IPC_CHANNELS.selectProjectDirectory),
  selectPromptFiles: () => ipcRenderer.invoke(IPC_CHANNELS.selectPromptFiles),
  savePastedImage: (input: SavePastedImageInput) => ipcRenderer.invoke(IPC_CHANNELS.savePastedImage, input),
  addProject: (input: AddProjectInput) => ipcRenderer.invoke(IPC_CHANNELS.addProject, input),
  removeProject: (input: RemoveProjectInput) => ipcRenderer.invoke(IPC_CHANNELS.removeProject, input),
  createProjectGroup: (input: CreateProjectGroupInput) => ipcRenderer.invoke(IPC_CHANNELS.createProjectGroup, input),
  updateProjectGroup: (input: UpdateProjectGroupInput) => ipcRenderer.invoke(IPC_CHANNELS.updateProjectGroup, input),
  deleteProjectGroup: (input: DeleteProjectGroupInput) => ipcRenderer.invoke(IPC_CHANNELS.deleteProjectGroup, input),
  moveProject: (input: MoveProjectInput) => ipcRenderer.invoke(IPC_CHANNELS.moveProject, input),
  rescanProject: (projectId: string) => ipcRenderer.invoke(IPC_CHANNELS.rescanProject, projectId),
  createConversation: (input: CreateConversationInput) => ipcRenderer.invoke(IPC_CHANNELS.createConversation, input),
  updateConversation: (input: UpdateConversationInput) => ipcRenderer.invoke(IPC_CHANNELS.updateConversation, input),
  deleteConversation: (input: DeleteConversationInput) => ipcRenderer.invoke(IPC_CHANNELS.deleteConversation, input),
  saveMemory: (input: SaveMemoryInput) => ipcRenderer.invoke(IPC_CHANNELS.saveMemory, input),
  updateMemory: (input: UpdateMemoryInput) => ipcRenderer.invoke(IPC_CHANNELS.updateMemory, input),
  deleteMemory: (input: DeleteMemoryInput) => ipcRenderer.invoke(IPC_CHANNELS.deleteMemory, input),
  expandPrompt: (input: ExpandPromptInput) => ipcRenderer.invoke(IPC_CHANNELS.expandPrompt, input),
  createTask: (input: CreateTaskInput) => ipcRenderer.invoke(IPC_CHANNELS.createTask, input),
  createTasksFromConversation: (input: CreateTasksFromConversationInput) =>
    ipcRenderer.invoke(IPC_CHANNELS.createTasksFromConversation, input),
  moveTaskGroupToReady: (input: MoveTaskGroupToReadyInput) =>
    ipcRenderer.invoke(IPC_CHANNELS.moveTaskGroupToReady, input),
  addProjectToTaskGroup: (input: AddProjectToTaskGroupInput) =>
    ipcRenderer.invoke(IPC_CHANNELS.addProjectToTaskGroup, input),
  updateTask: (input: UpdateTaskInput) => ipcRenderer.invoke(IPC_CHANNELS.updateTask, input),
  deleteTask: (input: DeleteTaskInput) => ipcRenderer.invoke(IPC_CHANNELS.deleteTask, input),
  deleteTaskGroup: (input: DeleteTaskGroupInput) => ipcRenderer.invoke(IPC_CHANNELS.deleteTaskGroup, input),
  createWorkItem: (input: CreateWorkItemInput) => ipcRenderer.invoke(IPC_CHANNELS.createWorkItem, input),
  updateWorkItem: (input: UpdateWorkItemInput) => ipcRenderer.invoke(IPC_CHANNELS.updateWorkItem, input),
  deleteWorkItem: (input: DeleteWorkItemInput) => ipcRenderer.invoke(IPC_CHANNELS.deleteWorkItem, input),
  updateSettings: (input: UpdateSettingsInput) => ipcRenderer.invoke(IPC_CHANNELS.updateSettings, input),
  tapdSyncBugs: () => ipcRenderer.invoke(IPC_CHANNELS.tapdSyncBugs),
  tapdImportFile: () => ipcRenderer.invoke(IPC_CHANNELS.tapdImportFile),
  tapdImportDefects: (input: TapdImportDefectsInput) => ipcRenderer.invoke(IPC_CHANNELS.tapdImportDefects, input),
  deleteTapdDefects: (input: DeleteTapdDefectsInput) => ipcRenderer.invoke(IPC_CHANNELS.deleteTapdDefects, input),
  syncTapdBugStatus: (input: SyncTapdBugStatusInput) => ipcRenderer.invoke(IPC_CHANNELS.syncTapdBugStatus, input),
  restoreTrashItem: (input: TrashItemInput) => ipcRenderer.invoke(IPC_CHANNELS.restoreTrashItem, input),
  permanentlyDeleteTrashItem: (input: TrashItemInput) => ipcRenderer.invoke(IPC_CHANNELS.permanentlyDeleteTrashItem, input),
  clearTrash: () => ipcRenderer.invoke(IPC_CHANNELS.clearTrash),
  trackAnalyticsEvent: (input: TrackAnalyticsEventInput) => ipcRenderer.invoke(IPC_CHANNELS.trackAnalyticsEvent, input),
  startTaskRun: (input: StartTaskRunInput) => ipcRenderer.invoke(IPC_CHANNELS.startTaskRun, input),
  cancelTaskRun: (input: CancelTaskRunInput) => ipcRenderer.invoke(IPC_CHANNELS.cancelTaskRun, input),
  undoTaskRun: (input: UndoTaskRunInput) => ipcRenderer.invoke(IPC_CHANNELS.undoTaskRun, input),
  completeTask: (input: CompleteTaskInput) => ipcRenderer.invoke(IPC_CHANNELS.completeTask, input),
  weeklyReport: (input: WeeklyReportInput) => ipcRenderer.invoke(IPC_CHANNELS.weeklyReport, input),
  gitSnapshot: (input: GitSnapshotInput) => ipcRenderer.invoke(IPC_CHANNELS.gitSnapshot, input),
  gitCommit: (input: GitCommitInput) => ipcRenderer.invoke(IPC_CHANNELS.gitCommit, input),
  gitPush: (input: GitPushInput) => ipcRenderer.invoke(IPC_CHANNELS.gitPush, input),
  gitBranchInfo: (input: GitSnapshotInput) => ipcRenderer.invoke(IPC_CHANNELS.gitBranchInfo, input),
  gitCheckout: (input: GitCheckoutInput) => ipcRenderer.invoke(IPC_CHANNELS.gitCheckout, input),
  gitCheckoutNewBranch: (input: GitCheckoutNewBranchInput) =>
    ipcRenderer.invoke(IPC_CHANNELS.gitCheckoutNewBranch, input),
  gitCommitSuggestion: (input: GitCommitSuggestionInput) => ipcRenderer.invoke(IPC_CHANNELS.gitCommitSuggestion, input),
  openProjectInEditor: (input: OpenProjectInput) => ipcRenderer.invoke(IPC_CHANNELS.openProjectInEditor, input),
  openExternal: (input: OpenExternalInput) => ipcRenderer.invoke(IPC_CHANNELS.openExternal, input),
  showNotification: (input: ShowNotificationInput) => ipcRenderer.invoke(IPC_CHANNELS.showNotification, input),
  codexHealth: () => ipcRenderer.invoke(IPC_CHANNELS.codexHealth),
  onRunUpdate: (callback) => {
    const listener = (_event: Electron.IpcRendererEvent, payload: unknown) => {
      callback(payload as Parameters<typeof callback>[0]);
    };
    ipcRenderer.on(IPC_CHANNELS.runUpdate, listener);
    return () => {
      ipcRenderer.removeListener(IPC_CHANNELS.runUpdate, listener);
    };
  },
  onRunOpen: (callback) => {
    const listener = (_event: Electron.IpcRendererEvent, payload: unknown) => {
      callback(payload as Parameters<typeof callback>[0]);
    };
    ipcRenderer.on(IPC_CHANNELS.runOpen, listener);
    return () => {
      ipcRenderer.removeListener(IPC_CHANNELS.runOpen, listener);
    };
  }
};

contextBridge.exposeInMainWorld('codexPromptStudio', api);
